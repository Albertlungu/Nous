{
  "name": "electron-app",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:backend:mac": "bash scripts/build_backend_macos.sh",
    "build:mac": "npm run build:backend:mac && electron-builder --mac",
    "build:mac:release": "npm run build:backend:mac && electron-builder --mac --publish never",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-reloader": "^1.2.3"
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  },
  "build": {
    "appId": "com.nous.app",
    "productName": "Nous",
    "afterSign": "scripts/notarize.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../api",
        "to": "api",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../src",
        "to": "src",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "backend-dist/nous-api-server",
        "to": "backend/nous-api-server"
      },
      {
        "from": "../artifacts",
        "to": "artifacts",
        "filter": [
          "**/*",
          "!models/model-fixed.pkl"
        ]
      },
      {
        "from": "../training_data",
        "to": "training_data"
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
